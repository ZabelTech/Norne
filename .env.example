# Copy to .env for local runs. On Fly, set these via `fly secrets set` instead.
# ── GitHub ────────────────────────────────────────────────────────────────
GH_TOKEN=ghp_xxx                 # repo + issues + PR scopes (fine-grained or classic)
GH_REPO=owner/repo
BOT_LOGIN=your-bot-username      # the account GH_TOKEN belongs to (used to detect human vs bot comments)
# ── Claude (Max subscription) ─────────────────────────────────────────────
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxx   # from `claude setup-token` on a logged-in Max machine
# DO NOT SET ANTHROPIC_API_KEY. If present, Claude Code bills per-token. Leave it unset everywhere.
# ── GLM (z.ai GLM Coding Plan) ────────────────────────────────────────────
ZAI_AUTH_TOKEN=xxx               # your z.ai key
ZAI_BASE_URL=https://api.z.ai/api/anthropic
GLM_RUNNER=pi                    # pi | claude-code-zai
GLM_TIER=lite                    # lite | pro | max
# ── Behaviour ─────────────────────────────────────────────────────────────
POLL_INTERVAL=30
AUTO_MERGE=false
MAX_REVIEW_ROUNDS=3
TRIGGER_LABEL=pipeline
DATA_DIR=./data
WORKDIR_ROOT=./data/work
